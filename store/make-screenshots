        ], "2026-11-08T09:14:20Z"),
        ("human", [text("Should I switch to whole wheat flour?")], "2026-11-08T09:16:05Z"),
        ("assistant", [text("A little helps: replacing 20–30% of the white flour with whole "
                            "wheat or rye gives the culture more nutrients and usually speeds "
                            "it up. You don't need to switch entirely.")], "2026-11-08T09:16:30Z"),
    ])

TRIP = chat(
    "8c4e2a6b-1d3f-4a5c-b7e9-2f4a6c8e0b12", "A week in Lisbon",
    "2026-11-03T18:02:00.000000Z", [
        ("human", [text("I have seven days in Lisbon in March. Plan a rough itinerary with "
