.dark .bar {{ background: #2e2925; color: #b8ada1; border-color: #3a332d; }}
</style></head><body>
<h1>{title}</h1><p class="sub">{subtitle}</p>
<div class="row">{body}</div>
</body></html>"""


def card(label, content, width, height, dark=False):
    return (f'<div class="card{" dark" if dark else ""}" style="width:{width}px;height:{height}px">'
            f'<div class="bar">{html.escape(label)}</div><pre>{html.escape(content)}</pre></div>')


def run(cmd, cwd):
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, check=True).stdout


def screenshot(page_html, out, tmp):
    src = os.path.join(tmp, os.path.basename(out) + ".html")
    with open(src, "w", encoding="utf-8") as f:
        f.write(page_html)
    profile = tempfile.mkdtemp(dir=tmp)
    subprocess.run([CHROME, "--headless=new", f"--user-data-dir={profile}", "--hide-scrollbars",
                    "--force-device-scale-factor=1", f"--window-size={SIZE[0]},{SIZE[1]}",
                    "--allow-file-access-from-files", "--virtual-time-budget=3000",
                    f"--screenshot={out}", "file://" + src],
                   check=True, capture_output=True)
    print(out)


def main():
    # Fixed times in the screenshots, whatever the local timezone.
    os.environ["TZ"] = "UTC"
    time.tzset()
    if not os.path.exists(CHROME):
        sys.exit(f"Chrome not found at {CHROME}; set CHROME")
    tmp = tempfile.mkdtemp(prefix="claude-sync-shots-")
    try:
        cs = load_listener(tmp)
        build_archive(cs)
        index = cs.load_index()
        rendered = open(os.path.join(cs.OUTPUT, index[SOURDOUGH["uuid"]]["file"]), encoding="utf-8").read()
        tree = "data/markdown/2026/\n" + "".join(
            f"  {os.path.basename(e['file'])}\n"
            for e in sorted(index.values(), key=lambda e: e["created_at"]))
        popup = popup_page(tmp)

        body = (
            '<div style="display:flex;flex-direction:column;gap:22px">'
            '<div class="card" style="width:330px"><div class="bar">Claude Sync (toolbar popup)</div>'
            f'<iframe src="file://{popup}" style="width:330px;height:170px"></iframe></div>'
            + card("Files on your computer", tree, 330, 330) + '</div>'
            + card(os.path.basename(index[SOURDOUGH["uuid"]]["file"]), rendered, 778, 640))
        screenshot(PAGE.format(w=SIZE[0], h=SIZE[1], body=body,
                               title="Your claude.ai chats, as files on your computer",
                               subtitle="One Markdown (or Org) file per chat, kept current "
                                        "in the background. Nothing leaves your machine."),
                   os.path.join(STORE, "screenshot-1.png"), tmp)

        log = run(["git", "log", "--stat", "--format=%h  %ad  %s", "--date=format:%Y-%m-%d %H:%M"],
                  cs.DATA)
        log = log.replace(cs.DATA, "data")
        status = run([sys.executable, os.path.join(REPO, "bin", "claude-sync"), "status"], tmp)
        status = status.replace(tmp + "/", "~/claude-sync/").replace("no sync recorded yet", "").rstrip()
        terminal = ("$ claude-sync status\n" + status + "\n\n$ git -C data log --stat\n" + log)
        body = card("Terminal", terminal, 1184, 640, dark=True)
        screenshot(PAGE.format(w=SIZE[0], h=SIZE[1], body=body,
                               title="Every change versioned in git",
                               subtitle="The raw conversations, with every branch, tool call "
                                        "and attachment text, are committed after each sync."),
                   os.path.join(STORE, "screenshot-2.png"), tmp)
    finally:
        del os.environ["CLAUDE_SYNC_CONFIG"]
        shutil.rmtree(tmp)


if __name__ == "__main__":
    main()
