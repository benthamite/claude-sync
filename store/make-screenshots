OLDER = [
    chat("1a2b3c4d-0e1f-4a2b-8c3d-4e5f6a7b8c90", "Bayes' theorem, explained",
         "2026-10-21T14:30:00.000000Z",
         [("human", [text("Explain Bayes' theorem with a medical test example.")], "2026-10-21T14:30:00Z"),
          ("assistant", [text("Suppose a test is 99% accurate…")], "2026-10-21T14:30:15Z")]),
    chat("5e6f7a8b-9c0d-4e1f-a2b3-c4d5e6f7a8b9", "Python CLI subcommands",
         "2026-10-27T11:05:00.000000Z",
         [("human", [text("How should I split this script into argparse subcommands?")], "2026-10-27T11:05:00Z"),
          ("assistant", [text("Use add_subparsers and one function per command…")], "2026-10-27T11:05:30Z")]),
]


def build_archive(cs):
    """Store the invented chats over three syncs, as the listener would."""
    cs.ensure_data_repo()
    for key, value in (("user.name", "claude-sync"), ("user.email", "claude-sync@localhost")):
        subprocess.run(["git", "-C", cs.DATA, "config", key, value], check=True)
    syncs = [(OLDER, "2026-10-27T11:10:00"), ([TRIP], "2026-11-03T18:30:00"),
             ([SOURDOUGH], "2026-11-08T09:30:00")]
    for convs, when in syncs:
        index = cs.load_index()
        for conv in convs:
            conv = json.loads(json.dumps(conv))
            conv["_claude_sync"] = {"org": ORG, "source": "api"}
            cs.store(conv, {"org": ORG, "org_name": "Personal", "name": conv["name"],
                            "updated_at": conv["updated_at"]}, index)
        cs.save_index(index)
        env = dict(os.environ, GIT_AUTHOR_DATE=when, GIT_COMMITTER_DATE=when)
        subprocess.run(["git", "-C", cs.DATA, "add", "-A", "raw", "index.json"], check=True)
        subprocess.run(["git", "-C", cs.DATA, "commit", "-q", "-m",
                        f"sync: {len(convs)} fetched, 0 list changes"], check=True, env=env)


def popup_page(tmp):
    """extension/popup.html, run with a chrome.* stub that reports a good sync."""
    folder = os.path.join(tmp, "popup")
    shutil.copytree(EXTENSION, folder)
    stub = """<script>
const at = Date.parse('2026-11-08T09:30:00');
window.chrome = {
  storage: {local: {get: async () => ({lastFinished: at, lastSuccess: at,
    lastSummary: {listed: 4, fetched: 1, cowork_sessions: 2}})},
    onChanged: {addListener() {}}},
  tabs: {query: async () => []},
  runtime: {sendMessage() {}},
};
</script>"""
    path = os.path.join(folder, "popup.html")
    with open(path, encoding="utf-8") as f:
        page = f.read()
    with open(path, "w", encoding="utf-8") as f:
        f.write(page.replace('<script src="popup.js">', stub + '\n<script src="popup.js">'))
    return path


PAGE = """<!doctype html><html><head><meta charset="utf-8"><style>
* {{ box-sizing: border-box; }}
body {{ margin: 0; width: {w}px; height: {h}px; overflow: hidden; background: #f4efe8;
