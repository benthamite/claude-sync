    "3f9a1c2e-5b7d-4e8f-a1c3-9d2b4f6e8a10", "Sourdough starter troubleshooting",
    "2026-11-08T09:14:00.000000Z", [
        ("human", [text("My starter doubled for a week, but now it barely rises and smells "
                        "like nail polish remover. What's going on?")], "2026-11-08T09:14:00Z"),
        ("assistant", [
            {"type": "thinking", "thinking": "Acetone smell usually means a hungry starter.",
             "summaries": []},
