#!/usr/bin/env python3
"""Make the Chrome Web Store screenshots (store/screenshot-*.png, 1280x800).

Everything shown is real output of this repository's code run on invented
chats: the listener stores and commits them in a throwaway data directory,
its renderer writes the Markdown, and the popup is extension/popup.html run
with a stub of the chrome.* API. No real conversation is involved.

Needs Google Chrome (run headless) and git.
"""

import html
import importlib.machinery
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

STORE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(STORE)
EXTENSION = os.path.join(REPO, "extension")
CHROME = os.environ.get("CHROME", "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
ORG = "0b5c2e4a-7d1f-4e8a-9c3b-6a2f1d8e4b70"
SIZE = (1280, 800)


def load_listener(tmp):
    config = os.path.join(tmp, "config.json")
    with open(config, "w") as f:
        json.dump({"data_dir": os.path.join(tmp, "data"), "state_dir": os.path.join(tmp, "state")}, f)
    os.environ["CLAUDE_SYNC_CONFIG"] = config
    loader = importlib.machinery.SourceFileLoader("claude_sync", os.path.join(REPO, "bin", "claude-sync"))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("claude_sync", loader))
    loader.exec_module(module)
    return module


def text(t):
    return {"type": "text", "text": t, "citations": []}


def msg(uuid, parent, sender, content, created):
    return {"uuid": uuid, "parent_message_uuid": parent, "sender": sender, "text": "",
            "content": content, "created_at": created, "updated_at": created,
            "attachments": [], "files": [], "index": 0, "truncated": False}


ROOT = "00000000-0000-4000-8000-000000000000"


def chat(cid, name, created, turns):
    """An invented conversation in the shape the app's endpoint returns."""
    messages, parent = [], ROOT
    for i, (sender, content, at) in enumerate(turns):
        uuid = f"{cid[:8]}-m{i}"
        messages.append(msg(uuid, parent, sender, content, at))
        parent = uuid
    return {"uuid": cid, "name": name, "summary": "", "model": "claude-opus-5-5",
            "created_at": created, "updated_at": turns[-1][2], "settings": {},
            "current_leaf_message_uuid": parent, "chat_messages": messages}


